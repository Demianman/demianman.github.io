{
  "colors": {
    "background-app": "#FBF7EE",
    "text-primary": "#18181B",
    "accent-purple": "#7928CA",
    "accent-pink": "#FF6B8B",
    "surface-tape": "rgba(255, 255, 255, 0.65)",
    "border-ink": "#18181B"
  },
  "cssVariables": {
    "--reading-width": "800px",
    "--nav-height": "80px",
    "--border-radius-polaroid": "4px"
  },
  "typography-language": {
    "display": {
      "family": "Space Grotesk",
      "purpose": "Headings and large statements",
      "script-coverage": "Latin",
      "weights": [400, 700],
      "source-type": "google-fonts",
      "locator": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&display=swap",
      "fallback": "sans-serif",
      "evidence": "Requested in prompt, validated via Google Fonts API"
    },
    "body": {
      "family": "EB Garamond",
      "purpose": "Running text and long-form reading",
      "script-coverage": "Latin",
      "weights": [400, 700],
      "source-type": "google-fonts",
      "locator": "https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,700;1,400;1,700&display=swap",
      "fallback": "serif",
      "evidence": "Requested in prompt, validated via Google Fonts API"
    },
    "mono": {
      "family": "Space Mono",
      "purpose": "Accents, stamps, typewriter text",
      "script-coverage": "Latin",
      "weights": [400, 700],
      "source-type": "google-fonts",
      "locator": "https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap",
      "fallback": "monospace",
      "evidence": "Requested in prompt, validated via Google Fonts API"
    }
  },
  "typography": {
    "roles": {
      "display": {
        "font-family": "\"Space Grotesk\", sans-serif",
        "font-size": "4rem",
        "font-weight": "700",
        "line-height": "1.1",
        "letter-spacing": "-0.02em"
      },
      "h1": {
        "font-family": "\"Space Grotesk\", sans-serif",
        "font-size": "3rem",
        "font-weight": "700",
        "line-height": "1.1",
        "letter-spacing": "-0.01em"
      },
      "h2": {
        "font-family": "\"Space Grotesk\", sans-serif",
        "font-size": "2.25rem",
        "font-weight": "700",
        "line-height": "1.2",
        "letter-spacing": "-0.01em"
      },
      "h3": {
        "font-family": "\"Space Grotesk\", sans-serif",
        "font-size": "1.5rem",
        "font-weight": "700",
        "line-height": "1.3",
        "letter-spacing": "0"
      },
      "body": {
        "font-family": "\"EB Garamond\", serif",
        "font-size": "1.125rem",
        "font-weight": "400",
        "line-height": "1.6",
        "letter-spacing": "0"
      },
      "mono": {
        "font-family": "\"Space Mono\", monospace",
        "font-size": "0.875rem",
        "font-weight": "700",
        "line-height": "1.4",
        "letter-spacing": "0.05em"
      }
    }
  },
  "spacing": {
    "spacing-micro": "0.25rem",
    "spacing-tight": "0.5rem",
    "spacing-snug": "1rem",
    "spacing-base": "1.5rem",
    "spacing-comfortable": "2rem",
    "spacing-loose": "3rem",
    "spacing-section": "5rem",
    "spacing-section-y": "6rem",
    "spacing-macro": "8rem"
  },
  "visual-signature": {
    "collage-tape": {
      "layer-composition": [
        "background-color: var(--surface-tape)",
        "backdrop-filter: blur(2px)",
        "transform: rotate(-2deg)",
        "box-shadow: 1px 1px 3px rgba(0,0,0,0.1)"
      ]
    },
    "torn-edge": {
      "layer-composition": [
        "clip-path: polygon(0% 0%, 100% 2%, 98% 100%, 1% 98%)"
      ]
    },
    "polaroid-card": {
      "layer-composition": [
        "background-color: #FFFFFF",
        "padding: 1rem 1rem 3rem 1rem",
        "box-shadow: 2px 4px 12px rgba(0,0,0,0.15)",
        "border: 1px solid var(--border-ink)",
        "border-radius: var(--border-radius-polaroid)"
      ]
    }
  },
  "accessibility": {
    "contrast_pairs": [
      {
        "usage": "Body text on main background",
        "foreground": "var(--text-primary)",
        "background": "var(--background-app)",
        "content_kind": "text",
        "font_size_px": 18,
        "font_weight": 400
      },
      {
        "usage": "Text on pink accents",
        "foreground": "var(--text-primary)",
        "background": "var(--accent-pink)",
        "content_kind": "text",
        "font_size_px": 14,
        "font_weight": 700
      },
      {
        "usage": "Light text on purple background (if any)",
        "foreground": "var(--background-app)",
        "background": "var(--accent-purple)",
        "content_kind": "ui_component",
        "font_size_px": 14,
        "font_weight": 700
      }
    ]
  }
}